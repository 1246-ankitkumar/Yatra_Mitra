MONGODB_URL=mongodb://localhost:27017/yatra-mitra
# Optional: set this if Node's DNS resolver cannot resolve MongoDB Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=change_this_secret
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional OpenAI fallback if Gemini is unavailable:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# External APIs (optional, features degrade gracefully if missing)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
WEATHER_API_KEY=
FLIGHT_API_KEY=
HOTEL_API_KEY=
JWT_REFRESH_SECRET=change_this_refresh_secret

# Used in the User-Agent sent to OpenStreetMap services (Overpass/Nominatim/Photon require it)
CONTACT_EMAIL=you@example.com
